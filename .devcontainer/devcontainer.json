{
  "name": "Secret Vault",
  "image": "mcr.microsoft.com/devcontainers/rust:1",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "forwardPorts": [1420],
  "portsAttributes": {
    "1420": {
      "label": "Vite preview",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install"
}
